{
  "name": "domino-quadruped-studio",
  "productName": "Domino Quadruped Studio",
  "private": true,
  "version": "0.4.2",
  "description": "Offline simulation, telemetry, calibration, diagnostics and firmware workspace for Domino.",
  "author": "Domino Quadruped Project",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "build": "vite build --configLoader runner",
    "start": "node server.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:prepare": "node desktop/prepare-resources.mjs",
    "desktop:package": "npm run build && npm run desktop:prepare && electron-builder --dir --x64",
    "desktop:make": "npm run build && npm run desktop:prepare && electron-builder --win nsis zip --x64",
    "desktop:publish": "npm run build && npm run desktop:prepare && electron-builder --win nsis zip --x64 --publish always",
    "release:firmware": "node desktop/release-firmware.mjs",
    "test": "node run-tests.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "electron-updater": "6.8.10",
    "node-hid": "^3.4.0",
    "three": "^0.179.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.domino.quadruped.studio",
    "productName": "Domino Quadruped Studio",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "desktop/app-title.mjs",
      "desktop/main.mjs",
      "desktop/paths.mjs",
      "desktop/preload.mjs",
      "desktop/project-files.mjs",
      "desktop/updater.mjs",
      "desktop/assets/**/*",
      "server.mjs",
      "boxer-hid.mjs",
      "companion-process.mjs",
      "companion-service.mjs",
      "control-state.mjs",
      "firmware-link.mjs",
      "firmware-service.mjs",
      "live-companion-adapter.mjs",
      "ardupilot-companion-adapter.mjs",
      "live-companion-core.mjs",
      "windows-serial-bridge.ps1",
      "web/src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/resources/domino",
        "to": "domino",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "executableName": "DominoQuadrupedStudio",
      "icon": "desktop/assets/domino-studio-icon-smooth.png",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Domino-Quadruped-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Domino Quadruped Studio v${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Blacksheep909",
        "repo": "Domino-ESP32-Quadruped",
        "releaseType": "release"
      }
    ]
  }
}
