<?xml version="1.0"?>
<robot name="domino_one_leg_clean">
  <material name="domino_carbon">
    <color rgba="0.08 0.09 0.10 1.0"/>
  </material>
  <material name="domino_printed">
    <color rgba="0.65 0.68 0.70 1.0"/>
  </material>
  <material name="domino_joint">
    <color rgba="0.15 0.28 0.42 1.0"/>
  </material>
  <material name="domino_foot">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <link name="body_mount">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.0010" ixy="0" ixz="0" iyy="0.0010" iyz="0" izz="0.0010"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.090 0.070 0.035"/>
      </geometry>
      <material name="domino_carbon"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.090 0.070 0.035"/>
      </geometry>
    </collision>
  </link>

  <link name="hip_carriage">
    <inertial>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.055 0.030"/>
      </geometry>
      <material name="domino_joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.010" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.055 0.030"/>
      </geometry>
    </collision>
  </link>

  <joint name="hip_ab_ad" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="body_mount"/>
    <child link="hip_carriage"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.523599" upper="0.523599" effort="8.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="upper_link">
    <inertial>
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.160"/>
      </geometry>
      <material name="domino_printed"/>
    </visual>
    <visual>
      <origin xyz="0.018 0 -0.080" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.145"/>
      </geometry>
      <material name="domino_carbon"/>
    </visual>
    <visual>
      <origin xyz="-0.018 0 -0.080" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.145"/>
      </geometry>
      <material name="domino_carbon"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.080" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.014" length="0.160"/>
      </geometry>
    </collision>
  </link>

  <joint name="upper_pitch" type="revolute">
    <origin xyz="0 0.038 -0.021" rpy="0 0 0"/>
    <parent link="hip_carriage"/>
    <child link="upper_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.523599" upper="1.047198" effort="8.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="lower_link">
    <inertial>
      <origin xyz="0 0 -0.0765" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.00006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0765" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.153"/>
      </geometry>
      <material name="domino_printed"/>
    </visual>
    <visual>
      <origin xyz="0.016 0 -0.0765" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0035" length="0.135"/>
      </geometry>
      <material name="domino_carbon"/>
    </visual>
    <visual>
      <origin xyz="-0.016 0 -0.0765" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0035" length="0.135"/>
      </geometry>
      <material name="domino_carbon"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0765" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.153"/>
      </geometry>
    </collision>
  </link>

  <joint name="lower_linkage" type="revolute">
    <origin xyz="0 0 -0.160" rpy="0 0 0"/>
    <parent link="upper_link"/>
    <child link="lower_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395" upper="0.0" effort="8.0" velocity="6.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="foot">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
      <material name="domino_foot"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.022"/>
      </geometry>
    </collision>
  </link>

  <joint name="foot_fixed" type="fixed">
    <origin xyz="0 0 -0.153" rpy="0 0 0"/>
    <parent link="lower_link"/>
    <child link="foot"/>
  </joint>
</robot>
